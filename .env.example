# Ork v2 — copia este archivo a .env y llena lo que necesites.
# .env está en .gitignore. Nunca lo commitees.

# ─── Núcleo ──────────────────────────────────────────────────────────────────
# Firma los magic links y las cookies de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORK_SECRET=

# Archivo SQLite. Relativo a la raíz del repo.
DATABASE_PATH=./ork.db

# URL base, para construir magic links y callbacks.
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# ─── Agente conversacional ───────────────────────────────────────────────────
# Si no pones ninguna, el agente corre con el motor de reglas (sin LLM).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Adaptadores de servicios cerrados (Spotify, Netflix) ────────────────────
# mock = determinista, sin tocar ninguna cuenta real. Es el default y así se
# entrega la Fase 3. NO pongas "real" hasta que el piloto esté listo.
ADAPTER_MODE=mock

# Reintentos del recontrato antes de declarar incidente.
RETRY_MAX=3

# El navegador de Playwright corre visible: el usuario tiene que ver qué pasa.
PLAYWRIGHT_HEADED=true

# Apagado automático: si el piloto detecta una cuenta restringida, se fuerza
# ADAPTER_MODE=mock y se levanta el banner rojo. Reactivar es manual, a propósito.
PILOT_AUTO_KILL=true

# ─── Stripe (modo test) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Fee por orquestación en plan Free (MXN). Se cobra SOLO tras éxito.
ORK_FEE_MXN=25
# Plan Premium mensual (MXN), orquestaciones ilimitadas.
ORK_PREMIUM_MXN=99

# ─── Rails de pago ───────────────────────────────────────────────────────────
# user_card = tarjeta del usuario vía Stripe (default).
# reap = rail agéntico de Reap, el del buildathon. Se conserva como opcional.
PAYMENT_RAIL=user_card
REAP_API_KEY=
REAP_BASE_URL=

# ─── Admin ───────────────────────────────────────────────────────────────────
# Protege /admin/pilot. Genera uno como el ORK_SECRET.
ADMIN_TOKEN=

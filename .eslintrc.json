{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "overrides": [
    // Código heredado del buildathon: funciona y está probado, pero usa `any`
    // contra las respuestas de la API de Reap. Se baja a aviso SOLO en estos
    // tres archivos para que `next build` pase; en todo el código de v2 la
    // regla sigue siendo error. Al tiparlos, borra este bloque.
    {
      "files": ["lib/agent.ts", "lib/rails/reap-rail.ts", "lib/reap.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "warn"
      }
    }
  ]
}
